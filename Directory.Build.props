<Project>
  <!-- NuGet metadata shared by every package built from this repository. -->
  <PropertyGroup>
    <Version>1.0.0</Version>
    <Authors>Scott Durow, lbaumdeveloper</Authors>
    <Copyright>Copyright (c) Scott Durow and contributors</Copyright>
    <PackageProjectUrl>https://github.com/lbaumdeveloper/SparkleXrm</PackageProjectUrl>
    <RepositoryUrl>https://github.com/lbaumdeveloper/SparkleXrm</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>dynamics-crm;dynamics-365;on-premises;spkl;plugins;deployment</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
