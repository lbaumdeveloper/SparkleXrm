{
  "$schema": "https://raw.githubusercontent.com/lbaumdeveloper/SparkleXrm/master/docs/spkl.schema.json",
  "plugins": [
    {
      "profile": "default,plugins",
      "solution": "<SolutionUniqueName>",
      "assemblypath": "..\\Plugins\\bin\\Debug\\Contoso.Plugins.dll"
    },
    {
      "profile": "default,actions",
      "solution": "<SolutionUniqueName>",
      "assemblypath": "..\\Actions\\bin\\Debug\\Contoso.Actions.dll"
    },
    {
      "profile": "default,workflows",
      "solution": "<SolutionUniqueName>",
      "assemblypath": "..\\Workflows\\bin\\Debug\\Contoso.Workflows.dll"
    }
  ],
  "webresources": [
    {
      "profile": "default",
      "solution": "<SolutionUniqueName>",
      "root": "..\\Webresources\\",
      "autodetect": "yes"
    }
  ],
  "earlyboundtypes": [
    {
      "profile": "default",
      "entities": "account,contact",
      "generateOptionsetEnums": true,
      "generateStateEnums": true,
      "filename": "..\\Helper\\EarlyBoundTypes.cs",
      "classNamespace": "Contoso.Helper",
      "serviceContextName": "XrmSvc"
    }
  ]
}
