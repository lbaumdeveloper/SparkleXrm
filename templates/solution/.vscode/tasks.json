{
  "version": "2.0.0",
  "options": {
    "shell": {
      "executable": "powershell.exe"
    }
  },
  "inputs": [
    {
      "id": "profile",
      "type": "pickString",
      "description": "spkl.json profile",
      "options": [
        "default",
        "plugins",
        "actions",
        "workflows"
      ],
      "default": "default"
    }
  ],
  "tasks": [
    {
      "label": "spkl: deploy plugins",
      "type": "shell",
      "command": "./Tooling/spkl.ps1 -Task plugins -Profile ${input:profile}",
      "problemMatcher": []
    },
    {
      "label": "spkl: deploy workflows",
      "type": "shell",
      "command": "./Tooling/spkl.ps1 -Task workflow -Profile workflows",
      "problemMatcher": []
    },
    {
      "label": "spkl: deploy webresources",
      "type": "shell",
      "command": "./Tooling/spkl.ps1 -Task webresources",
      "problemMatcher": []
    },
    {
      "label": "spkl: download webresources",
      "type": "shell",
      "command": "./Tooling/spkl.ps1 -Task download-webresources",
      "problemMatcher": []
    },
    {
      "label": "spkl: generate early-bound types",
      "type": "shell",
      "command": "./Tooling/spkl.ps1 -Task earlybound",
      "problemMatcher": []
    },
    {
      "label": "build",
      "type": "shell",
      "command": "msbuild /t:Build /p:Configuration=Debug /v:minimal",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    }
  ]
}
