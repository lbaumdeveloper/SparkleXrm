<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2011/08/nuspec.xsd">
  <metadata>
    <id>Spkl.OnPrem</id>
    <version>$version$</version>
    <title>spkl for Dynamics 365 on-premises</title>
    <authors>Scott Durow, lbaumdeveloper</authors>
    <copyright>Copyright (c) Scott Durow and contributors</copyright>
    <license type="expression">MIT</license>
    <icon>icon.png</icon>
    <projectUrl>https://github.com/lbaumdeveloper/SparkleXrm</projectUrl>
    <repository type="git" url="https://github.com/lbaumdeveloper/SparkleXrm" />
    <description>Deployment task runner for Dynamics 365 v9 on-premises and online: plugins, workflow activities, web resources, early-bound types and solutions. Fork of spkl by Scott Durow.</description>
    <tags>dynamics-crm dynamics-365 on-premises spkl plugins deployment</tags>
    <developmentDependency>true</developmentDependency>
    <dependencies>
      <dependency id="Microsoft.CrmSdk.CoreTools" version="9.1.0.79" />
    </dependencies>
  </metadata>
  <files>
    <file src="..\..\..\assets\icon.png" target="" />
    <file src="..\..\..\templates\solution\Tooling\spkl.json" target="content\spkl.json" />
    <file src="..\..\..\templates\solution\Tooling\spkl.ps1" target="content\spkl.ps1" />
    <file src="..\bin\Release\net48\**\*" target="tools" />
    <file src="..\..\CrmSvcUtilFilteringService\bin\Release\spkl.CrmSvcUtilExtensions.dll" target="tools\spkl.CrmSvcUtilExtensions.dll" />
  </files>
</package>