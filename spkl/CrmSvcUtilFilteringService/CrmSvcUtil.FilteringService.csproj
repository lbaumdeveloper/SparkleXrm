<Project Sdk="Microsoft.NET.Sdk">
  <!-- CrmSvcUtil extension that limits early-bound generation to the entities and actions in spkl.json. Loaded by CrmSvcUtil.exe, so it targets the same framework. -->
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <RootNamespace>spkl.CrmSvcUtilExtensions</RootNamespace>
    <AssemblyName>spkl.CrmSvcUtilExtensions</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.60" />
    <PackageReference Include="Microsoft.CrmSdk.CoreTools" Version="9.1.0.79" GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="CrmSvcUtil">
      <HintPath>$(PkgMicrosoft_CrmSdk_CoreTools)\content\bin\coretools\CrmSvcUtil.exe</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.ServiceModel" />
  </ItemGroup>
  <ItemGroup>
    <None Update="spkl.crmsvcutil.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
